# MongoDB Atlas: preencha a URI autenticada somente no .env privado
MONGODB_URI=
# Alternativa Data Connect / PostgreSQL remoto
DATA_MODE=mongodb
FIREBASE_PROJECT_ID=jehcampus-bd
DATA_CONNECT_LOCATION=southamerica-east1
DATA_CONNECT_SERVICE=jehcampus-bd-service
# Neste computador: firebase-cli. Em hospedagem: adc.
DATA_CONNECT_AUTH=firebase-cli
# Alternativa MongoDB (somente quando DATA_MODE=mongodb)
MONGODB_HOST=20b101f5-255b-4cb8-aaab-83238954a33b.southamerica-east1.firestore.goog:443
MONGODB_DATABASE=jeh_campus
MONGODB_USERNAME=
MONGODB_PASSWORD=
# Use uma senha com pelo menos 12 caracteres.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
PORT=4173
HOST=127.0.0.1
